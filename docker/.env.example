# Settings for docker-compose.yml: rename this file to .env (keep it private if it holds a password).

# Your user and group ids, so the files eidolon writes are yours. On Linux and macOS: run `id -u` and `id -g`.
USER_ID=1000
GROUP_ID=1000

# The folder with your photos (absolute path). It is mounted read-only.
PHOTOS_DIR=/home/me/Pictures

# The port on this computer; open http://localhost:<PORT>
PORT=8765

# Optional: a fixed access key, so bookmarks keep working after a restart (else a new one each start).
# At least 16 letters, digits, '-', '_' or '.'. Make one: openssl rand -base64 24 | tr '+/' '-_'
ACCESS_KEY=

# Network share (only with one of the volume blocks in docker-compose.yml uncommented).
# An IP address is the safest for NAS_ADDRESS: the share is mounted by the Docker host's kernel.
NAS_ADDRESS=192.168.1.20
# SMB: the share's name (//NAS_ADDRESS/NAS_SHARE) and an account that may read it
NAS_SHARE=photos
NAS_USER=me
NAS_PASSWORD=
# NFS: the exported path
NFS_EXPORT=/volume1/photos
